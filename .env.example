########################################
# APPLICATION
########################################
APP_NAME="Gestão de Clínicas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
# Armazenamento interno sempre em UTC. A apresentacao usa o fuso da
# organizacao/unidade (ver secao BUSINESS abaixo). Nunca grave datas ja
# convertidas para o horario local da clinica.
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

########################################
# BUSINESS (regras de negocio padrao)
########################################
BUSINESS_DEFAULT_TIMEZONE=America/Sao_Paulo
BUSINESS_DEFAULT_CURRENCY=BRL
BUSINESS_DEFAULT_LOCALE=pt_BR

########################################
# LOCAL PORTS (host -> container, sempre em 127.0.0.1)
########################################
APP_PORT=8080
VITE_PORT=5173
FORWARD_DB_PORT=5433
MAILPIT_UI_PORT=8025
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# UID/GID do usuario do container "app", para casar permissoes com o host.
# Rode `id -u` / `id -g` caso os valores padrao nao sirvam no seu sistema.
UID=1000
GID=1000

########################################
# DATABASE (PostgreSQL)
########################################
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gestao_clinicas
DB_USERNAME=gestao_clinicas
# Nunca use uma senha real/producao aqui. Gerada automaticamente pelo
# docker/scripts/bootstrap.sh quando o .env ainda nao existir.
DB_PASSWORD=
DB_TEST_DATABASE=gestao_clinicas_test

########################################
# REDIS
########################################
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

########################################
# CACHE / SESSION / QUEUE
########################################
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies seguros somente quando servido via HTTPS. Em local (HTTP) deve
# permanecer false; habilite em ambientes com TLS.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis

########################################
# MAIL (Mailpit local)
########################################
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="nao-responda@gestao-clinicas.local"
MAIL_FROM_NAME="${APP_NAME}"

########################################
# MINIO / S3 (storage compativel com S3)
########################################
# Disco padrao permanece "local" nesta fase. O disco "s3" fica configurado e
# testavel, mas nao e usado como storage padrao ainda.
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=clinical-files
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Credenciais do servidor MinIO (console + API). Nunca use valores reais aqui.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

########################################
# FILAMENT ADMIN
########################################
# Usados apenas pelo seeder opcional de desenvolvimento
# (database/seeders/PlatformAdminSeeder.php). Deixe em branco para nao criar
# nenhum administrador automaticamente - prefira `php artisan app:create-platform-admin`.
SEED_PLATFORM_ADMIN=false
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

########################################
# DEVELOPMENT
########################################
VITE_APP_NAME="${APP_NAME}"
